{
  "name": "@dsh-community/desktop",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "description": "Community reconstruction of a desktop shell around official `dsh web`.",
  "desktopName": "dsh-community.desktop",
  "scripts": {
    "icons": "node scripts/write-tray-icon.mjs",
    "build": "node scripts/write-tray-icon.mjs && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm build && electron .",
    "stage-host": "node scripts/stage-official-runtime.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@dsh-community/dsh-bridge": "workspace:*",
    "@dsh-community/shared-types": "workspace:*"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "dev.dshcommunity.desktop",
    "productName": "DSH Community",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "resources/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime-host/node_modules",
        "to": "host/node_modules"
      },
      {
        "from": "../../contracts/compatibility/latest-tested.json",
        "to": "contracts/latest-tested.json"
      },
      {
        "from": "../../contracts/compatibility/matrix.json",
        "to": "contracts/matrix.json"
      }
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Development",
      "icon": "resources/icon.png",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "dir"
      ],
      "icon": "resources/icon.png"
    }
  }
}
