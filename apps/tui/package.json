{
  "name": "@dsh-community/tui",
  "version": "0.1.2-alpha.3",
  "private": true,
  "type": "module",
  "description": "Community launcher around official dsh --profile headless. Not a third-party TUI.",
  "bin": {
    "dsh-community": "./dist/bin.js",
    "dsh-community-tui": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm build && node dist/bin.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.2-alpha.3",
    "@dsh-community/dsh-bridge": "workspace:*"
  }
}
