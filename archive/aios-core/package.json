{
  "name": "aios-core",
  "version": "1.0.0",
  "description": "AIOS Core — agent reliability kernel with task contracts, evidence gates, deterministic verification, replay, and rollback.",
  "type": "module",
  "main": "kernel/runtime.js",
  "types": "kernel/runtime.ts",
  "bin": {
    "aios": "cli/aios.ts"
  },
  "exports": {
    ".": {
      "types": "./kernel/runtime.ts",
      "default": "./kernel/runtime.ts"
    },
    "./kernel": {
      "types": "./kernel/schema/index.ts",
      "default": "./kernel/schema/index.ts"
    },
    "./reliability": {
      "types": "./kernel/reliability.ts",
      "default": "./kernel/reliability.ts"
    },
    "./eval": {
      "types": "./kernel/eval.ts",
      "default": "./kernel/eval.ts"
    },
    "./codex": {
      "types": "./cli/codex.ts",
      "default": "./cli/codex.ts"
    },
    "./codex/evidence": {
      "types": "./cli/codex_evidence.ts",
      "default": "./cli/codex_evidence.ts"
    },
    "./policy": {
      "types": "./governor/policy.ts",
      "default": "./governor/policy.ts"
    },
    "./governor": {
      "types": "./governor/scope.ts",
      "default": "./governor/scope.ts"
    },
    "./memory": {
      "types": "./memory/index.ts",
      "default": "./memory/index.ts"
    }
  },
  "files": [
    "kernel/",
    "governor/",
    "memory/",
    "cli/",
    "scripts/codex-shadow-capture.mjs"
  ],
  "scripts": {
    "arch-guard": "node scripts/arch-guard.mjs",
    "pretest": "node scripts/arch-guard.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/arch-guard.mjs && tsc --noEmit && vitest run",
    "codex:shadow-capture": "node scripts/codex-shadow-capture.mjs"
  },
  "keywords": [
    "agent-reliability",
    "agent-ci",
    "agent",
    "runtime",
    "evidence-gate",
    "regression",
    "project-memory",
    "software-engineering"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamanager2012/aios-core.git"
  },
  "homepage": "https://github.com/kamanager2012/aios-core#readme",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^3.0.0",
    "madge": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  }
}
