{
  "name": "dsh-suite-root",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness Community Client Suite - Official Runtime Centric",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" --filter \"./apps/*\" build",
    "typecheck": "tsc --build",
    "test": "pnpm --filter @dsh-community/dsh-bridge test && vitest run contracts/tests",
    "test:bridge": "pnpm --filter @dsh-community/dsh-bridge test",
    "test:contracts": "vitest run contracts/tests",
    "check:contracts": "tsx scripts/contract-checker.ts",
    "dev:tui": "pnpm --filter @dsh-community/tui dev",
    "dev:desktop": "pnpm --filter @dsh-community/desktop dev",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@11.21.0"
}
