{
  "name": "governor-core",
  "version": "1.0.0",
  "description": "Deterministic, agent-agnostic policy & accountability layer for AI coding agents: intercept tool calls, allow/deny/ask, tamper-evident append-only audit. A guardrail, not an OS-level sandbox.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "James Oldman",
  "homepage": "https://github.com/kamanager2012/governor-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamanager2012/governor-core.git"
  },
  "bugs": {
    "url": "https://github.com/kamanager2012/governor-core/issues"
  },
  "keywords": [
    "ai-agents",
    "governance",
    "guardrails",
    "policy",
    "accountability",
    "audit",
    "claude-code",
    "hooks",
    "pretooluse"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "aigov": "./dist/cli.js"
  },
  "files": [
    "dist",
    "policy.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "hook": "node --import tsx src/adapters/claude-code/hook.ts",
    "cli": "node --import tsx src/cli.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
