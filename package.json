{
  "name": "dsh-community",
  "private": true,
  "version": "0.1.1-rc.2",
  "description": "Community preview distribution around official DeepSeek Harness. Not an official client.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamanager2012/dsh-community.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "pnpm --filter @dsh-community/shared-types --filter @dsh-community/dsh-bridge --filter @dsh-community/tui-surface --filter @dsh-community/desktop build",
    "build:tui": "pnpm --filter @dsh-community/shared-types --filter @dsh-community/dsh-bridge --filter @dsh-community/tui-surface --filter @dsh-community/tui build",
    "typecheck": "pnpm --filter @dsh-community/shared-types build && pnpm --filter @dsh-community/dsh-bridge build && pnpm --filter @dsh-community/tui-adapter --filter @dsh-community/tui-surface --filter @dsh-community/desktop --filter @dsh-community/upstream-contract --filter @dsh-community/marketplace typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "pnpm build:tui && pnpm --filter @dsh-community/tui start",
    "new": "pnpm build:tui && pnpm --filter @dsh-community/tui start -- new",
    "doctor": "pnpm build:tui && pnpm --filter @dsh-community/tui start -- doctor",
    "sessions": "pnpm build:tui && pnpm --filter @dsh-community/tui start -- sessions",
    "plugins": "pnpm build:tui && pnpm --filter @dsh-community/tui start -- plugins",
    "desktop": "pnpm --filter @dsh-community/desktop start",
    "tui": "pnpm build:tui && pnpm --filter @dsh-community/tui start",
    "desktop:package": "pnpm --filter @dsh-community/desktop package",
    "official:help": "pnpm --filter @dsh-community/dsh-bridge exec dsh --help",
    "official:version": "pnpm --filter @dsh-community/dsh-bridge exec dsh --version",
    "contracts:extract": "node scripts/extract-official-contracts.mjs",
    "marketplace": "pnpm --filter @dsh-community/marketplace build && pnpm --filter @dsh-community/marketplace start"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@dsh-community/tui-surface": "workspace:*"
  }
}
