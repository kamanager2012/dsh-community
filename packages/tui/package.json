{
  "name": "@dsh-community/tui-surface",
  "version": "0.1.1-rc.1",
  "private": true,
  "type": "module",
  "description": "Community-owned terminal surface for official DeepSeek Harness. Own code only: official host seams, no third-party harness products.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "ink-spinner": "^5.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "0.1.1-rc.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.18",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
